# Copy to .env (never commit .env). Every value here is a placeholder.
# Supabase: Project -> Connect -> ORM -> Prisma gives both connection strings.

# Pooled connection (Transaction pooler, port 6543). Used by the running app.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode connection (port 5432). Used by `prisma migrate`, the setup scripts and the tests.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Storage (private "uploads" bucket for photos). Server-side only: never expose the secret key.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# Cookie encryption secret, 32+ random characters, DIFFERENT in every environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-32+-character-string"

# Public base URL used to build the NFC/QR link printed on each barrel. Must be reachable
# from a customer's phone, so use the real domain outside local development.
APP_URL="http://localhost:3000"
